APP_NAME=Aletheia
APP_VERSION=1.0.0
APP_DEBUG=false
HOST=0.0.0.0
PORT=9900

DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
TAVILY_API_KEY=your-tavily-api-key-here
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
MILVUS_ALLOW_DROP_ON_DIMENSION_MISMATCH=false

RAG_TOP_K=3
RAG_RETRIEVAL_MODE=hybrid
RAG_BM25_TOP_K=20
RAG_HYBRID_CANDIDATE_K=20
RAG_RRF_K=60
RAG_MODEL=qwen-max
# Optional: send only the agent's chat model to another OpenAI-compatible
# endpoint (for example a relay). Base URL and key must be set together; the
# DashScope key is never sent there. Embeddings, knowledge and long-term memory
# keep using DashScope. AGENT_MODEL empty means RAG_MODEL. RAG_ENABLE_THINKING
# is DashScope-only and is not sent to the separate endpoint.
# AGENT_MODEL_BASE_URL=https://relay.example.com/v1
# AGENT_MODEL_API_KEY=
# AGENT_MODEL=gpt-4o
# Comma-separated response model names accepted from a relay without warning (D-107).
# AGENT_ACCEPTED_MODELS=
# Action when a provider answers with an unaccepted model name: warn (default) or stop.
# AGENT_ON_MODEL_MISMATCH=warn
# Context window of that model in tokens; tool results kept inline scale with it
# (32768 keeps 8000 characters, 400000 allows 120000). Empty means CONTEXT_WINDOW_TOKENS.
# AGENT_MODEL_CONTEXT_TOKENS=400000
# The separate endpoint gets a prompt_cache_key per conversation (a hash, not the
# session name) to raise prompt-cache hits; set false if the endpoint refuses it.
# AGENT_MODEL_PROMPT_CACHE_KEY=true
# Optional model profiles: give the router, team members or explore members their own model
# (stage 4d-2). Copy models.example.toml to models.toml; without that file every role uses the
# settings above. Empty turns the file off; a path set here must exist.
# MODEL_PROFILES_FILE=models.toml
# 工具权限规则文件（默认 permissions.toml，不存在则不启用；明确指定时必须存在；留空关闭）。
# PERMISSIONS_FILE=permissions.toml
# 用户自定义 MCP 服务配置文件（默认 mcp.toml，不存在则不启用；明确指定时必须存在；留空关闭）。
# MCP_SERVERS_FILE=mcp.toml
# 定时任务配置文件（默认 schedules.toml，不存在则不启用；明确指定时必须存在；留空关闭）。
# SCHEDULES_FILE=schedules.toml

# Hooks: an audit file per run (host-authored events only: no model text, tool output or
# file contents) in the conversation's archive directory; needs CONVERSATION_STORAGE_DIR.
# HOOKS_AUDIT=true
# Token allowance per conversation across all its runs; empty means no limit.
# CONVERSATION_MAX_TOKENS=2000000
RAG_JSON_MODE=true
# Optional provider-specific setting. For Qwen structured output use false.
# RAG_ENABLE_THINKING=false
RAG_MODEL_TIMEOUT_SECONDS=30
# Single-loop task deadline in seconds (stage 5b). Replaces AGENT_STEP_TIMEOUT_SECONDS, which is no longer read;
# the team's deadline is --team-timeout (default 180). Waiting for an approval does not count.
AGENT_TASK_TIMEOUT_SECONDS=480
# 阻塞任务（等待 ask_user 回答）在内存中保留的时间（秒），默认 86400（24 小时）；超时后需重新提问。
# BLOCKED_TASK_TTL_SECONDS=86400
# With the sandbox, remind the single loop once to run the tests after it changed files (D-087).
# AGENT_REMIND_TO_RUN=true
RAG_QUERY_REWRITE_MODEL=qwen3.8-flash
RAG_ENABLE_RERANK=true
RAG_RERANK_TOP_K=12
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CACHE_DIR=data/models/huggingface
RAG_RERANK_TIMEOUT_SECONDS=10
RAG_CONTEXT_TOKEN_BUDGET=1800

CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
MCP_FILESYSTEM_ROOT=
MCP_FILESYSTEM_WRITE_ROOT=
# Choosing the working directory (D-074): folders the agent may never read or write, and
# optionally the only folders a working directory may be in; both separated by ';'.
WORKSPACE_CHOICE=true
WORKSPACE_DENY_DIRS=
WORKSPACE_ALLOWED_ROOTS=

PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10

# Recoverable conversation/tool archives, on by default. Relative paths resolve from the
# project root (application-owned; never user supplied). Set it empty to turn archiving off.
CONVERSATION_STORAGE_DIR=data/conversations
# Background history compression (--compress-history): loopback only.
# 只许本机地址；没写时用本机 Ollama 的 qwen3:4b-instruct。
# SUMMARY_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# SUMMARY_MODEL=qwen3:4b-instruct
# Ollama 默认只开 4096；想一批多摘几轮，启动 Ollama 前设 OLLAMA_CONTEXT_LENGTH=16384，
# 这里写同样的值；两边不一致时以小的为准。
# SUMMARY_MODEL_CONTEXT_TOKENS=4096
# Personas (docs/persona_plan.md): named instructions and run defaults, one folder per user.
# On by default; relative paths resolve from the project root. Set it empty to turn personas off.
PERSONAS_DIR=data/personas
# Long-term memory (optional). Empty keeps it off; set a PostgreSQL DSN to turn it on.
# Vectors go to MILVUS_HOST/MILVUS_PORT in their own collection.
LONGTERM_MEMORY_DSN=
LONGTERM_MEMORY_COLLECTION=agent_memories
LONGTERM_CONTEXT_TOKENS=600
LONGTERM_RECALL_LIMIT=5
# Web backend (python -m app.api). Local only by default. WEB_ACCESS_TOKEN is required
# unless WEB_ALLOW_NO_TOKEN=true, which is accepted only on a loopback WEB_HOST.
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_ACCESS_TOKEN=
WEB_ALLOW_NO_TOKEN=false
WEB_USER_ID=local
WEB_MAX_CONCURRENT_RUNS=2
# 网页每次运行的令牌上限与时间预算（默认均不限；超限按 budget 失败）。
# WEB_RUN_MAX_TOKENS=
# WEB_RUN_MAX_SECONDS=
WEB_EVENT_RETENTION_SECONDS=1800
WEB_SHUTDOWN_TIMEOUT_SECONDS=30
# Tools the page asks you to approve before each call (empty asks for none), and how long
# it waits for an answer before refusing; the wait does not count against step timeouts.
# (While the list is not empty, tools of unknown effect are asked about too.)
# WEB_APPROVAL_TOOLS=write_file,edit_file,run_python,run_tests
# WEB_APPROVAL_TIMEOUT_SECONDS=300
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_OUTPUT_TOKENS=8192
CONTEXT_SAFETY_TOKENS=1024
