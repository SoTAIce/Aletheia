APP_NAME=Aletheia
APP_VERSION=1.0.0
APP_DEBUG=false
HOST=0.0.0.0
PORT=9900

DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
TAVILY_API_KEY=your-tavily-api-key-here
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
MILVUS_ALLOW_DROP_ON_DIMENSION_MISMATCH=false

RAG_TOP_K=3
RAG_RETRIEVAL_MODE=hybrid
RAG_BM25_TOP_K=20
RAG_HYBRID_CANDIDATE_K=20
RAG_RRF_K=60
RAG_MODEL=qwen-max
# Optional: send only the agent's chat model to another OpenAI-compatible
# endpoint (for example a relay). Base URL and key must be set together; the
# DashScope key is never sent there. Embeddings, knowledge and long-term memory
# keep using DashScope. AGENT_MODEL empty means RAG_MODEL. RAG_ENABLE_THINKING
# is DashScope-only and is not sent to the separate endpoint.
# AGENT_MODEL_BASE_URL=https://relay.example.com/v1
# AGENT_MODEL_API_KEY=
# AGENT_MODEL=gpt-4o
# Context window of that model in tokens; tool results kept inline scale with it
# (32768 keeps 8000 characters, 400000 allows 120000). Empty means CONTEXT_WINDOW_TOKENS.
# AGENT_MODEL_CONTEXT_TOKENS=400000
# The separate endpoint gets a prompt_cache_key per conversation (a hash, not the
# session name) to raise prompt-cache hits; set false if the endpoint refuses it.
# AGENT_MODEL_PROMPT_CACHE_KEY=true

# Hooks: an audit file per run (host-authored events only: no model text, tool output or
# file contents) in the conversation's archive directory; needs CONVERSATION_STORAGE_DIR.
# HOOKS_AUDIT=true
# Token allowance per conversation across all its runs; empty means no limit.
# CONVERSATION_MAX_TOKENS=2000000
RAG_JSON_MODE=true
# Optional provider-specific setting. For Qwen structured output use false.
# RAG_ENABLE_THINKING=false
RAG_MODEL_TIMEOUT_SECONDS=30
AGENT_STEP_TIMEOUT_SECONDS=60
AGENT_PLANNING_TIMEOUT_SECONDS=60
RAG_QUERY_REWRITE_MODEL=qwen3.8-flash
RAG_ENABLE_RERANK=true
RAG_RERANK_TOP_K=12
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CACHE_DIR=data/models/huggingface
RAG_RERANK_TIMEOUT_SECONDS=10
RAG_CONTEXT_TOKEN_BUDGET=1800

CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
MCP_FILESYSTEM_ROOT=
MCP_FILESYSTEM_WRITE_ROOT=

PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10

# Recoverable conversation/tool archives, on by default. Relative paths resolve from the
# project root (application-owned; never user supplied). Set it empty to turn archiving off.
CONVERSATION_STORAGE_DIR=data/conversations
# Long-term memory (optional). Empty keeps it off; set a PostgreSQL DSN to turn it on.
# Vectors go to MILVUS_HOST/MILVUS_PORT in their own collection.
LONGTERM_MEMORY_DSN=
LONGTERM_MEMORY_COLLECTION=agent_memories
LONGTERM_CONTEXT_TOKENS=600
LONGTERM_RECALL_LIMIT=5
# Web backend (python -m app.api). Local only by default. WEB_ACCESS_TOKEN is required
# unless WEB_ALLOW_NO_TOKEN=true, which is accepted only on a loopback WEB_HOST.
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_ACCESS_TOKEN=
WEB_ALLOW_NO_TOKEN=false
WEB_USER_ID=local
WEB_MAX_CONCURRENT_RUNS=2
WEB_EVENT_RETENTION_SECONDS=1800
WEB_SHUTDOWN_TIMEOUT_SECONDS=30
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_OUTPUT_TOKENS=8192
CONTEXT_SAFETY_TOKENS=1024
