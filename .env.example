APP_NAME=Aletheia
APP_VERSION=1.0.0
APP_DEBUG=false
HOST=0.0.0.0
PORT=9900

DASHSCOPE_API_KEY=your-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
TAVILY_API_KEY=your-tavily-api-key-here
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000
MILVUS_ALLOW_DROP_ON_DIMENSION_MISMATCH=false

RAG_TOP_K=3
RAG_RETRIEVAL_MODE=hybrid
RAG_BM25_TOP_K=20
RAG_HYBRID_CANDIDATE_K=20
RAG_RRF_K=60
RAG_MODEL=qwen-max
RAG_JSON_MODE=true
# Optional provider-specific setting. For Qwen structured output use false.
# RAG_ENABLE_THINKING=false
RAG_MODEL_TIMEOUT_SECONDS=30
AGENT_STEP_TIMEOUT_SECONDS=60
AGENT_PLANNING_TIMEOUT_SECONDS=60
RAG_QUERY_REWRITE_MODEL=qwen3.8-flash
RAG_ENABLE_RERANK=true
RAG_RERANK_TOP_K=12
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_CACHE_DIR=data/models/huggingface
RAG_RERANK_TIMEOUT_SECONDS=10
RAG_CONTEXT_TOKEN_BUDGET=1800

CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
MCP_FILESYSTEM_ROOT=
MCP_FILESYSTEM_WRITE_ROOT=

PROMETHEUS_BASE_URL=http://127.0.0.1:9090
PROMETHEUS_REQUEST_TIMEOUT=10

# Optional recoverable conversation/tool archives. Empty keeps legacy memory-only mode.
CONVERSATION_STORAGE_DIR=
# Example storage path: data/conversations (application-owned; never user supplied).
CONTEXT_WINDOW_TOKENS=32768
CONTEXT_OUTPUT_TOKENS=2048
CONTEXT_SAFETY_TOKENS=1024
